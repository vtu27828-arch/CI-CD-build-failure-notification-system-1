# ---- Core ----
SECRET_KEY=change-this-to-a-long-random-string      # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./cicd_notifier.db
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true            # seeds sample data + enables "Simulate failure" + simulated notifications

# ---- Claude AI (leave empty => rule-based DEMO analysis) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Jenkins webhook ----
JENKINS_TOKEN=            # shared secret; your Jenkinsfile sends it in the X-Jenkins-Token header
# (Jenkins URL / user / API token are entered per-user in the app: Settings -> Jenkins)

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Optional global defaults for Slack / Teams (users can also set their own in Settings) ----
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
